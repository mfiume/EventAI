// Configuration file template for EventAI 2.0
// Copy this to Config.xcconfig if needed
// Config.xcconfig is gitignored for security

// Environment Configuration
BUILD_ENVIRONMENT = production

// Note: EventAI 2.0 has removed the backend service
// Users now configure their own AI API keys (Anthropic or OpenAI) directly in the app
// API keys are stored securely in iOS Keychain, not in config files
//
// To use EventAI:
// 1. Launch the app
// 2. Open Settings (gear icon)
// 3. Choose AI Provider (Anthropic or OpenAI)
// 4. Enter your API key
// 5. Test connection and save
